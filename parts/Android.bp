android_app {
    name: "PicassoParts",
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.palette_palette",
        "SettingsLibCollapsingToolbarBaseActivity",
        "org.lineageos.settings.resources",
    ],
}
