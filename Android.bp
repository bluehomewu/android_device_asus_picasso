soong_namespace {
    imports: ["hardware/qcom-caf/bootctrl"],
}

prebuilt_etc_xml {
    name: "vendor.qti.data.factory@2.0-manifest",
    src: "vintf/vendor.qti.data.factory@2.0.xml",
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    soc_specific: true,
}

prebuilt_etc {
    name: "picasso-ril-overrides",
    src: "configs/ril/empty",
    installable: false,
    overrides: ["libreference-ril"],
    soc_specific: true,
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wlan_mac.bin",
    symlink_target: "/vendor/factory/wlan_mac.bin",
}

mkdir {
    name: "vendor_asusfw_mountpoint",
    dir: "asusfw",
    vendor: true,
}

install_symlink {
    name: "vendor_factory_symlink",
    vendor: true,
    installed_location: "factory",
    symlink_target: "/mnt/vendor/persist",
}
