on post-fs-data
    # Audio
    chown system audio /mnt/vendor/persist/audio/rcv_cal_val
    chown system audio /mnt/vendor/persist/audio/spk_cal_val

    # Battery
    mount_all /vendor/etc/fstab.battery
    restorecon_recursive /batinfo

    # NFC
    mkdir /data/vendor/nfc 0660 nfc nfc
    chown nfc nfc /dev/nq-nci

    # Sensors
    write /sys/class/sensors/psensor/load_cal 1
    write /sys/class/sensors/psensor_2nd/load_cal 1

    # ZRAM
    swapon_all fstab.default

on boot
    # Accelerometer
    chown system camera /dev/asus2ndAccelSensor
    chown system camera /sys/class/icm206xx/accel2_poll_delay

    # Display
    chown system system /proc/globalHbm

    # Gyroscope
    chown system camera /dev/asus2ndGyroSensor
    chown system camera /sys/class/icm206xx/gyro2_poll_delay

    # PSensor
    chown system system /sys/class/sensors/psensor/hi_cal
    chown system system /sys/class/sensors/psensor/inf_cal
    chown system system /sys/class/sensors/psensor/load_cal
    chown system system /sys/class/sensors/psensor/low_cal
    chown system system /sys/class/sensors/psensor/proxm
    chown system system /sys/class/sensors/psensor/selection
    chown system system /sys/class/sensors/psensor/switch

    # PSensor 2
    chown system system /sys/class/sensors/psensor_2nd/hi_cal
    chown system system /sys/class/sensors/psensor_2nd/inf_cal
    chown system system /sys/class/sensors/psensor_2nd/load_cal
    chown system system /sys/class/sensors/psensor_2nd/low_cal
    chown system system /sys/class/sensors/psensor_2nd/proxm
    chown system system /sys/class/sensors/psensor_2nd/selection
    chown system system /sys/class/sensors/psensor_2nd/switch

    # LSensor
    chown system system /sys/class/sensors/lsensor/adc
    chown system system /sys/class/sensors/lsensor/cal
    chown system system /sys/class/sensors/lsensor/selection
    chown system system /sys/class/sensors/lsensor/switch

    # LSensor 2
    chown system system /sys/class/sensors/lsensor_2nd/adc
    chown system system /sys/class/sensors/lsensor_2nd/cal
    chown system system /sys/class/sensors/lsensor_2nd/selection
    chown system system /sys/class/sensors/lsensor_2nd/switch

    # ASUS thermal and touch state hooks
    chown root root /sys/class/asuslib/set_virtualthermal
    chmod 0660 /sys/class/asuslib/set_virtualthermal
    chown system system /sys/devices/platform/soc/990000.i2c/i2c-1/1-0038/fts_phone_state
    chmod 0660 /sys/devices/platform/soc/990000.i2c/i2c-1/1-0038/fts_phone_state

on charger
    # Battery
    mount_all /vendor/etc/fstab.battery --early

on property:persist.vendor.zram.enable=${persist.vendor.zram.enable}
    # ZRAM
    setprop vendor.zram.enable ${persist.vendor.zram.enable}
    setprop vendor.zram.disksize ${persist.vendor.zram.disksize}

on property:sys.boot_completed=1
    # cpuset parameters
    write /dev/cpuset/background/cpus 0-1
    write /dev/cpuset/restricted/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/foreground/cpus 0-6

    # IRQ Tuning
    # IRQ 243: msm_drm
    # IRQ 240: kgsl_3d0_irq
    write /proc/irq/243/smp_affinity_list 2
    write /proc/irq/240/smp_affinity_list 1

    # Camera
    mkdir /data/vendor/camera 0770 cameraserver camera
    copy /proc/driver/dualcam_cali /data/vendor/camera/dualcam_cali
    copy /proc/driver/dualcam_cali_1x /data/vendor/camera/dualcam_cali_1x
    copy /proc/driver/dualcam_cali_3x /data/vendor/camera/dualcam_cali_3x
    copy /vendor/factory/dualcam_cali.bin /data/vendor/camera/dualcam_cali.bin
    chmod 0755 /data/vendor/camera/dualcam_cali.bin
    chmod 0755 /data/vendor/camera/dualcam_cali
    chmod 0755 /data/vendor/camera/dualcam_cali_1x
    chmod 0755 /data/vendor/camera/dualcam_cali_3x
    copy /proc/driver/dualcam_cali_1x /data/vendor/camera/arcsoft_calibration_uw.bin
    copy /proc/driver/dualcam_cali_3x /data/vendor/camera/arcsoft_calibration_wt.bin
    chmod 0755 /data/vendor/camera/arcsoft_calibration_uw.bin
    chmod 0755 /data/vendor/camera/arcsoft_calibration_wt.bin
    copy /vendor/lib64/camera/arcsoft_dc_calibration_t.bin /data/vendor/camera/arcsoft_dc_calibration_t.bin
    copy /vendor/lib64/camera/arcsoft_dc_calibration_u.bin /data/vendor/camera/arcsoft_dc_calibration_u.bin
    copy /vendor/lib64/camera/arcsoft_dc_calibration_w.bin /data/vendor/camera/arcsoft_dc_calibration_w.bin
    copy /vendor/lib64/camera/arcsoft_eis_configure /data/vendor/camera/arcsoft_eis_configure
    chmod 0755 /data/vendor/camera/arcsoft_dc_calibration_t.bin
    chmod 0755 /data/vendor/camera/arcsoft_dc_calibration_u.bin
    chmod 0755 /data/vendor/camera/arcsoft_dc_calibration_w.bin
    chmod 0755 /data/vendor/camera/arcsoft_eis_configure
    copy /vendor/lib64/camera/template_0.bin /data/vendor/camera/template_0.bin
    copy /vendor/lib64/camera/template_1.bin /data/vendor/camera/template_1.bin
    copy /vendor/lib64/camera/template_2.bin /data/vendor/camera/template_2.bin
    copy /vendor/lib64/camera/template_6.bin /data/vendor/camera/template_6.bin
    copy /vendor/lib64/camera/template_7.bin /data/vendor/camera/template_7.bin
    chmod 0755 /data/vendor/camera/template_0.bin
    chmod 0755 /data/vendor/camera/template_1.bin
    chmod 0755 /data/vendor/camera/template_2.bin
    chmod 0755 /data/vendor/camera/template_6.bin
    chmod 0755 /data/vendor/camera/template_7.bin
    chmod 0644 /vendor/factory/dualcam_cali.bin

    # Power
    write /sys/class/asuslib/boot_completed 1
    start battery_ver

on property:sys.battery.shutdown=1
    setprop sys.powerctl shutdown
    setprop sys.battery.shutdown 0

on property:sys.battery.versionupdate=1
    start battery_ver

on property:sys.battery.statuscheck=1
    start battery_status

on property:vendor.asus.virtualtherm=*
    # Thermal
    write /sys/class/asuslib/set_virtualthermal ${vendor.asus.virtualtherm}

on property:vendor.camera.set.apk.usingname=*
    # Camera
    setprop vendor.camera.apk.usingname ${vendor.camera.set.apk.usingname}

on property:vendor.asus.dis_flash_light=1
    # Camera
    write /proc/driver/asus_flash "2 1"

on property:vendor.asus.dis_flash_light=0
    # Camera
    write /proc/driver/asus_flash "2 0"

on property:vendor.audio.in_call=*
    # Touch
    write /sys/devices/platform/soc/990000.i2c/i2c-1/1-0038/fts_phone_state ${vendor.audio.in_call}

on property:vendor.zram.enable=*
   # ZRAM
   start asus_zram

service asus_zram /vendor/bin/init.asus.zram.sh
    user root
    group root
    disabled
    seclabel u:r:vendor_qti_init_shell:s0
    oneshot

service vendor.camera-provider-2-4 /vendor/bin/hw/android.hardware.camera.provider@2.4-service_64
    override
    interface android.hardware.camera.provider@2.4::ICameraProvider legacy/0
    interface vendor.asus.bspcam@1.0::IAsusBspCameraInterface default
    interface vendor.qti.hardware.camera.postproc@1.0::IPostProcService camerapostprocservice
    class hal
    user cameraserver
    group audio camera input drmrpc oem_2907
    ioprio rt 4
    capabilities SYS_NICE
    writepid /dev/cpuset/camera-daemon/tasks /dev/stune/foreground/tasks

service battery_ver /vendor/bin/sh /vendor/bin/firmware_version.sh
    class late_start
    user system
    group system
    disabled
    oneshot
    seclabel u:r:vendor_qti_init_shell:s0

service battery_status /vendor/bin/sh /vendor/bin/gaugeIC_status
    class late_start
    user system
    group system
    disabled
    oneshot
    seclabel u:r:vendor_qti_init_shell:s0

service vendor.sensors-hal-2-1-multihal /vendor/bin/hw/android.hardware.sensors@2.1-service.multihal
    override
    class hal
    user system
    group system wakelock context_hub input
    writepid /dev/cpuset/system-background/tasks
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
