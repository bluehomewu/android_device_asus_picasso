cc_library {
    name: "libgptutils.picasso",
    vendor: true,
    recovery_available: true,
    shared_libs: [
        "libcutils",
        "liblog",
        "libz",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ] + select(soong_config_variable("QTI_GPT_UTILS", "USE_BSG_FRAMEWORK"), {
        false: [],
        default: ["-D_BSG_FRAMEWORK_KERNEL_HEADERS"],
    }),
    srcs: [
        "gpt-utils.cpp",
        "recovery-ufs-bsg.cpp",
    ],
    owner: "qti",
    export_include_dirs: ["."],
}
