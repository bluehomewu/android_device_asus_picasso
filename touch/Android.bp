cc_binary {
    name: "vendor.lineage.touch-service.picasso",
    init_rc: ["vendor.lineage.touch-service.picasso.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.picasso.xml"],
    relative_install_path: "hw",
    srcs: [
        "GloveMode.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "vendor.lineage.touch-V1-ndk",
    ],
    vendor: true,
}
